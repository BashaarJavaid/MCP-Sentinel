    "302": "    def merge(self, env: dict[str, Value], branches: list[dict[str, Value]]) -> None:",
    "303": "        first, *rest = branches or [{}]",
    "304": "        for name in set().union(*(branch.keys() for branch in branches)):",
    "305": "            root = name.removeprefix(\"#record:\")",
    "306": "            initial = (",
    "307": "                Value(key=root)",
    "308": "                if name.startswith(\"#record:\")",
    "309": "                and root in self.objects",
    "310": "                and any(name not in branch for branch in branches)",
    "311": "                else UNKNOWN_VALUE",
    "312": "            )",
    "313": "            value = first.get(name, initial)",
    "314": "            if (",
    "315": "                not name.startswith(\"#guard:\")",
    "316": "                and (",
    "317": "                    value.sources",
    "318": "                    or not (",
    "319": "                        value.contained",
    "320": "                        or value.checked_path_parent",
    "321": "                        or value.option_safe",
    "322": "                        or value.url_checks",
    "323": "                    )",
    "324": "                )",
    "325": "                and all(",
    "326": "                    (other := branch.get(name, initial)) is value or other == value",
    "327": "                    for branch in rest",
    "328": "                )",
    "329": "            ):",
    "330": "                # Reuse unchanged state as the Python flow does. Guard markers",
    "331": "                # and source-free safety claims still use their normal merge.",
    "332": "                env[name] = value",
    "333": "                continue",
    "334": "            values = [branch.get(name, initial) for branch in branches]",
    "335": "            env[name] = (",
    "336": "                Value(contained=all(value.contained for value in values))",
    "337": "                if name.startswith(\"#guard:\")",
    "338": "                else self.combined(values)",
    "339": "            )"
  },
