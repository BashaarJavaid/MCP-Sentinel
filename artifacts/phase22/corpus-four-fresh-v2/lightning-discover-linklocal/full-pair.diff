+        ip.is_private
+        or ip.is_loopback
+        or ip.is_link_local  # includes 169.254.0.0/16 (cloud metadata) and fe80::/10
+        or ip.is_reserved
+        or ip.is_multicast
+        or ip.is_unspecified
