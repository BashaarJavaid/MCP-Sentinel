+    assert parsed["payment"]["paid"] is True
+    assert parsed["payment"]["amountSats"] == 42
+    assert parsed["payment"]["l402Token"] == "macaroon:preimage"
+    assert "ALREADY PAID" in parsed["message"]
+    assert "do NOT pay again" in parsed["message"]
