nts_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"daf65d459a7d4a7392a3d3f8a0d07fae328e996c","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/daf65d459a7d4a7392a3d3f8a0d07fae328e996c","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/daf65d459a7d4a7392a3d3f8a0d07fae328e996c"}]}]