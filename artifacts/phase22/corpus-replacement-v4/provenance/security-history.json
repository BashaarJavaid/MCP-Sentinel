[{"sha":"7ac072161dde72f22968cf708b64218cea9ae028","node_id":"C_kwDORwKEPtoAKDdhYzA3MjE2MWRkZTcyZjIyOTY4Y2Y3MDhiNjQyMThjZWE5YWUwMjg","commit":{"author":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-07-14T22:53:22Z"},"committer":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-07-14T22:53:22Z"},"message":"fix: block IPv6-embedded private IPv4 in SSRF guard (NAT64/6to4/compat)\n\nAdversarial testing found assertSafeUrl allowed IPv6 notations that embed a\nprivate/loopback IPv4 via a translation/tunneling scheme, which the previous\n::ffff: handling did not cover:\n\n  ::a.b.c.d          IPv4-compatible (::/96)\n  ::ffff:0:a.b.c.d   IPv4-translated (::ffff:0:0:0/96)\n  64:ff9b::a.b.c.d   NAT64 well-known prefix (RFC 6052)\n  2002:V4::          6to4 (RFC 3056)\n\nOn a host with NAT64/DNS64 or 6to4 (e.g. IPv6-only deployments) these route to\nthe embedded IPv4, so [64:ff9b::7f00:1] reaches 127.0.0.1 and\n[2002:a9fe:a9fe::] reaches the cloud metadata endpoint.\n\nRewrite isPrivateV6 around a hextet parser that extracts the embedded IPv4 and\nblocks it only when private — genuinely public embedded IPv4 (::ffff:8.8.8.8,\n64:ff9b::8.8.8.8, public 6to4) stays allowed. Same class as GHSA-pvrj-8cg3-j5f8.\n\nVerified: 16 private-embedded forms blocked, 6 public IPv6 (incl. public\n6to4/NAT64/mapped) allowed — no over-blocking.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","tree":{"sha":"a05ff6fef15c29755f6f9dc62bce767bb282c238","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/trees/a05ff6fef15c29755f6f9dc62bce767bb282c238"},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/commits/7ac072161dde72f22968cf708b64218cea9ae028","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/7ac072161dde72f22968cf708b64218cea9ae028","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/7ac072161dde72f22968cf708b64218cea9ae028","comments_url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/7ac072161dde72f22968cf708b64218cea9ae028/comments","author":{"login":"ymw0407","id":77202633,"node_id":"MDQ6VXNlcjc3MjAyNjMz","avatar_url":"https://avatars.githubusercontent.com/u/77202633?v=4","gravatar_id":"","url":"https://api.github.com/users/ymw0407","html_url":"https://github.com/ymw0407","followers_url":"https://api.github.com/users/ymw0407/followers","following_url":"https://api.github.com/users/ymw0407/following{/other_user}","gists_url":"https://api.github.com/users/ymw0407/gists{/gist_id}","starred_url":"https://api.github.com/users/ymw0407/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ymw0407/subscriptions","organizations_url":"https://api.github.com/users/ymw0407/orgs","repos_url":"https://api.github.com/users/ymw0407/repos","events_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ymw0407","id":77202633,"node_id":"MDQ6VXNlcjc3MjAyNjMz","avatar_url":"https://avatars.githubusercontent.com/u/77202633?v=4","gravatar_id":"","url":"https://api.github.com/users/ymw0407","html_url":"https://github.com/ymw0407","followers_url":"https://api.github.com/users/ymw0407/followers","following_url":"https://api.github.com/users/ymw0407/following{/other_user}","gists_url":"https://api.github.com/users/ymw0407/gists{/gist_id}","starred_url":"https://api.github.com/users/ymw0407/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ymw0407/subscriptions","organizations_url":"https://api.github.com/users/ymw0407/orgs","repos_url":"https://api.github.com/users/ymw0407/repos","events_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"97bd2053485df329fadc72d7a95e05910b7868ee","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/97bd2053485df329fadc72d7a95e05910b7868ee","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/97bd2053485df329fadc72d7a95e05910b7868ee"}]},{"sha":"177ec5f8ee9c2d5749035777e562f699971b0da9","node_id":"C_kwDORwKEPtoAKDE3N2VjNWY4ZWU5YzJkNTc0OTAzNTc3N2U1NjJmNjk5OTcxYjBkYTk","commit":{"author":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-05-27T05:09:37Z"},"committer":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-05-27T05:09:37Z"},"message":"fix: block IPv4-mapped IPv6 loopback bypass in SSRF guard (GHSA-pvrj-8cg3-j5f8)\n\nThe WHATWG URL parser hex-normalizes IPv4-mapped IPv6 addresses, so\nhttp://[::ffff:127.0.0.1] becomes http://[::ffff:7f00:1] before reaching\nisPrivateV6(). The existing guard only handled the dotted-decimal form\n(net.isIPv4(\"7f00:1\") is false), so the hex form fell through and\nloopback / private-range addresses bypassed assertSafeUrl().\n\nParse the two trailing hex groups back into an IPv4 address and run it\nthrough isPrivateV4(). Verified against 127.0.0.1, 10.x, 192.168.x,\n169.254.169.254 in both dotted and hex forms; public IPv4-mapped\naddresses (e.g. ::ffff:0808:0808 for 8.8.8.8) still pass.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","tree":{"sha":"43ac4b9884fa5f50392410fe8a6aa929fece118f","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/trees/43ac4b9884fa5f50392410fe8a6aa929fece118f"},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/commits/177ec5f8ee9c2d5749035777e562f699971b0da9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/177ec5f8ee9c2d5749035777e562f699971b0da9","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/177ec5f8ee9c2d5749035777e562f699971b0da9","comments_url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/177ec5f8ee9c2d5749035777e562f699971b0da9/comments","author":{"login":"ymw0407","id":77202633,"node_id":"MDQ6VXNlcjc3MjAyNjMz","avatar_url":"https://avatars.githubusercontent.com/u/77202633?v=4","gravatar_id":"","url":"https://api.github.com/users/ymw0407","html_url":"https://github.com/ymw0407","followers_url":"https://api.github.com/users/ymw0407/followers","following_url":"https://api.github.com/users/ymw0407/following{/other_user}","gists_url":"https://api.github.com/users/ymw0407/gists{/gist_id}","starred_url":"https://api.github.com/users/ymw0407/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ymw0407/subscriptions","organizations_url":"https://api.github.com/users/ymw0407/orgs","repos_url":"https://api.github.com/users/ymw0407/repos","events_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ymw0407","id":77202633,"node_id":"MDQ6VXNlcjc3MjAyNjMz","avatar_url":"https://avatars.githubusercontent.com/u/77202633?v=4","gravatar_id":"","url":"https://api.github.com/users/ymw0407","html_url":"https://github.com/ymw0407","followers_url":"https://api.github.com/users/ymw0407/followers","following_url":"https://api.github.com/users/ymw0407/following{/other_user}","gists_url":"https://api.github.com/users/ymw0407/gists{/gist_id}","starred_url":"https://api.github.com/users/ymw0407/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ymw0407/subscriptions","organizations_url":"https://api.github.com/users/ymw0407/orgs","repos_url":"https://api.github.com/users/ymw0407/repos","events_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"42daa70c391cde4396de877541a64a9c3f761a9d","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/42daa70c391cde4396de877541a64a9c3f761a9d","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/42daa70c391cde4396de877541a64a9c3f761a9d"}]},{"sha":"c5c523cd55b24ae1680c5bacef95d59a81ae3450","node_id":"C_kwDORwKEPtoAKGM1YzUyM2NkNTViMjRhZTE2ODBjNWJhY2VmOTVkNTlhODFhZTM0NTA","commit":{"author":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-05-13T03:19:19Z"},"committer":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-05-13T03:19:19Z"},"message":"fix: validate URLs and output_dir to prevent SSRF (GHSA-hv85-774v-26fg)\n\nauth_fetch and download_media accepted arbitrary URLs and reached them\nas the MCP server process, letting a prompt-injected LLM fetch loopback,\nlink-local, and private-range hosts (e.g. cloud IMDS, internal services).\ndownload_media additionally wrote responses to a user-controlled\noutput_dir with no path constraint.\n\nAdd src/security.ts with two guards applied at every dispatch site:\n\n- assertSafeUrl: rejects non-http(s) schemes and any host that resolves\n  to a private, loopback, link-local, CGNAT, or multicast address (IPv4\n  and IPv6). Opt-in escape hatches via AUTH_FETCH_ALLOW_PRIVATE and\n  AUTH_FETCH_ALLOW_HOSTS for trusted local-dev use.\n- resolveSafeOutputDir: confines download_media output to\n  ~/.auth-fetch-mcp/downloads/, rejecting absolute paths and \"..\"\n  escapes.\n\nREADME documents the new restrictions and the opt-in env vars.","tree":{"sha":"b9a653d364caec4edb79d83a71f6b62bcb3352ed","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/trees/b9a653d364caec4edb79d83a71f6b62bcb3352ed"},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/commits/c5c523cd55b24ae1680c5bacef95d59a81ae3450","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"u