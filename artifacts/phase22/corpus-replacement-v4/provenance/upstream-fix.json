{"sha":"177ec5f8ee9c2d5749035777e562f699971b0da9","node_id":"C_kwDORwKEPtoAKDE3N2VjNWY4ZWU5YzJkNTc0OTAzNTc3N2U1NjJmNjk5OTcxYjBkYTk","commit":{"author":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-05-27T05:09:37Z"},"committer":{"name":"ymw0407","email":"yunminwo1211@gmail.com","date":"2026-05-27T05:09:37Z"},"message":"fix: block IPv4-mapped IPv6 loopback bypass in SSRF guard (GHSA-pvrj-8cg3-j5f8)\n\nThe WHATWG URL parser hex-normalizes IPv4-mapped IPv6 addresses, so\nhttp://[::ffff:127.0.0.1] becomes http://[::ffff:7f00:1] before reaching\nisPrivateV6(). The existing guard only handled the dotted-decimal form\n(net.isIPv4(\"7f00:1\") is false), so the hex form fell through and\nloopback / private-range addresses bypassed assertSafeUrl().\n\nParse the two trailing hex groups back into an IPv4 address and run it\nthrough isPrivateV4(). Verified against 127.0.0.1, 10.x, 192.168.x,\n169.254.169.254 in both dotted and hex forms; public IPv4-mapped\naddresses (e.g. ::ffff:0808:0808 for 8.8.8.8) still pass.\n\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>","tree":{"sha":"43ac4b9884fa5f50392410fe8a6aa929fece118f","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/trees/43ac4b9884fa5f50392410fe8a6aa929fece118f"},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/git/commits/177ec5f8ee9c2d5749035777e562f699971b0da9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/177ec5f8ee9c2d5749035777e562f699971b0da9","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/177ec5f8ee9c2d5749035777e562f699971b0da9","comments_url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/177ec5f8ee9c2d5749035777e562f699971b0da9/comments","author":{"login":"ymw0407","id":77202633,"node_id":"MDQ6VXNlcjc3MjAyNjMz","avatar_url":"https://avatars.githubusercontent.com/u/77202633?v=4","gravatar_id":"","url":"https://api.github.com/users/ymw0407","html_url":"https://github.com/ymw0407","followers_url":"https://api.github.com/users/ymw0407/followers","following_url":"https://api.github.com/users/ymw0407/following{/other_user}","gists_url":"https://api.github.com/users/ymw0407/gists{/gist_id}","starred_url":"https://api.github.com/users/ymw0407/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ymw0407/subscriptions","organizations_url":"https://api.github.com/users/ymw0407/orgs","repos_url":"https://api.github.com/users/ymw0407/repos","events_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"ymw0407","id":77202633,"node_id":"MDQ6VXNlcjc3MjAyNjMz","avatar_url":"https://avatars.githubusercontent.com/u/77202633?v=4","gravatar_id":"","url":"https://api.github.com/users/ymw0407","html_url":"https://github.com/ymw0407","followers_url":"https://api.github.com/users/ymw0407/followers","following_url":"https://api.github.com/users/ymw0407/following{/other_user}","gists_url":"https://api.github.com/users/ymw0407/gists{/gist_id}","starred_url":"https://api.github.com/users/ymw0407/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ymw0407/subscriptions","organizations_url":"https://api.github.com/users/ymw0407/orgs","repos_url":"https://api.github.com/users/ymw0407/repos","events_url":"https://api.github.com/users/ymw0407/events{/privacy}","received_events_url":"https://api.github.com/users/ymw0407/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"42daa70c391cde4396de877541a64a9c3f761a9d","url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/commits/42daa70c391cde4396de877541a64a9c3f761a9d","html_url":"https://github.com/ymw0407/auth-fetch-mcp/commit/42daa70c391cde4396de877541a64a9c3f761a9d"}],"stats":{"total":13,"additions":13,"deletions":0},"files":[{"sha":"3f741c4b9f7ce359232fc2a7bfbbc46b9b5700dd","filename":"src/security.ts","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/ymw0407/auth-fetch-mcp/blob/177ec5f8ee9c2d5749035777e562f699971b0da9/src%2Fsecurity.ts","raw_url":"https://github.com/ymw0407/auth-fetch-mcp/raw/177ec5f8ee9c2d5749035777e562f699971b0da9/src%2Fsecurity.ts","contents_url":"https://api.github.com/repos/ymw0407/auth-fetch-mcp/contents/src%2Fsecurity.ts?ref=177ec5f8ee9c2d5749035777e562f699971b0da9","patch":"@@ -46,6 +46,19 @@ function isPrivateV6(ip: string): boolean {\n   if (lower.startsWith(\"::ffff:\")) {\n     const v4 = lower.slice(7);\n     if (net.isIPv4(v4)) return isPrivateV4(v4);\n+    // WHATWG URL parser hex-normalizes IPv4-mapped IPv6 addresses, e.g.\n+    // ::ffff:127.0.0.1 -> ::ffff:7f00:1. Reconstruct the IPv4 from the two\n+    // trailing hex groups so the private-range check still applies.\n+    const groups = v4.split(\":\");\n+    if (\n+      groups.length === 2 &&\n+      groups.every((g) => /^[0-9a-f]{1,4}$/.test(g))\n+    ) {\n+      const hi = parseInt(groups[0], 16);\n+      const lo = parseInt(groups[1], 16);\n+      const mapped = `${(hi >> 8) & 0xff}.${hi & 0xff}.${(lo >> 8) & 0xff}.${lo & 0xff}`;\n+      return isPrivateV4(mapped);\n+    }\n   }\n   return false;\n }"}]}