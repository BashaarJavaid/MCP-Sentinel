              "help": {
                "text": "Resolve the requested path and allowed root, reject paths outside the root using component-aware containment, and use the validated value. FP risk: Medium: intentionally unrestricted file tools and unsupported custom validators require review; string prefixes alone do not prove containment."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-012",
              "id": "SENT-012",
              "name": "Path containment failure",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium: intentionally unrestricted file tools and unsupported custom validators require review; string prefixes alone do not prove containment.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI02:2026",
                  "name": "Tool Misuse & Exploitation"
                }
              },
              "shortDescription": {
                "text": "Path containment failure"
              }
            }
          ],
          "semanticVersion": "1.3.0",
          "version": "1.3.0"
        }
      }
    }
  ],
  "version": "2.1.0"
