                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "An HTTP route lacks inherited authentication or uses a no-op verifier."
              },
              "help": {
                "text": "Require credential verification and an explicit rejection path before route execution. FP risk: Low: intentional public routes must be explicitly configured."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-006",
              "id": "SENT-006",
              "name": "Missing or ineffective route authentication",
              "properties": {
