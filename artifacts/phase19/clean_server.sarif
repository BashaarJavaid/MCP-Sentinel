              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Manifest bytes reach registration without a trusted hash or signature verification."
              },
              "help": {
                "text": "Verify a pinned SHA-256 digest or trusted detached signature before parsing and use. FP risk: Low: custom verification beyond the supported crypto APIs may require later coverage."
