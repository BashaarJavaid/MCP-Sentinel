                "falsePositiveRisk": "Medium: custom validation and unsupported command wrappers need review; argv lists alone do not prevent option injection.",
                "impact": "Critical",
                "owaspCategory": {
                  "id": "ASI05:2026",
                  "name": "Unexpected Code Execution"
                }
              },
              "shortDescription": {
                "text": "Command option injection"
              }
            },
            {
              "defaultConfiguration": {
