              "help": {
                "text": "Permit only required HTTP(S) destinations, reject private and loopback addresses, and enforce checks on every requested URL and redirect. FP risk: Medium: custom clients and unsupported validators require review; DNS rebinding is outside this rule's claim."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-015",
              "id": "SENT-015",
              "name": "Server-side request forgery",
              "properties": {
                "engine": "ast",
                "falsePositiveRisk": "Medium: custom clients and unsupported validators require review; DNS rebinding is outside this rule's claim.",
                "impact": "High",
                "owaspCategory": {
