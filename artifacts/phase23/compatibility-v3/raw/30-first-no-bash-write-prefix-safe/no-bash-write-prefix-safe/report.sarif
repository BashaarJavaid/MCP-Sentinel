          "language": "en-US",
          "name": "MCP Sentinel",
          "properties": {
            "gptReview": null,
            "reportSchemaVersion": "1.7.0"
          },
          "rules": [
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "The tool declares filesystem or network access broader than its handler uses."
              },
              "help": {
                "text": "Narrow each declared scope to the resources the handler actually requires. FP risk: Medium: legitimately broad tools require an explicit capability justification."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-001",
              "id": "SENT-001",
              "name": "Overly broad tool permission scope",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium: legitimately broad tools require an explicit capability justification.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI03:2026",
                  "name": "Identity & Privilege Abuse"
                }
              },
              "shortDescription": {
                "text": "Overly broad tool permission scope"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Tool-controlled input reaches an unsafe execution or deserialization sink."
              },
              "help": {
                "text": "Replace dynamic execution with explicit parsers and fixed command allowlists. FP risk: Low: fixed literal subprocess argument vectors are excluded."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-002",
              "id": "SENT-002",
              "name": "Unsafe execution from tool input",
              "properties": {
                "engine": "semgrep",
                "falsePositiveRisk": "Low: fixed literal subprocess argument vectors are excluded.",
                "impact": "Critical",
                "owaspCategory": {
                  "id": "ASI05:2026",
                  "name": "Unexpected Code Execution"
                }
              },
              "shortDescription": {
                "text": "Unsafe execution from tool input"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "A tool handler consumes parameters before framework or explicit validation."
              },
              "help": {
                "text": "Use an official input schema or explicit validation before first use. FP risk: Medium: custom validators outside the supported boundary may not be recognized."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-003",
              "id": "SENT-003",
              "name": "Missing tool input validation",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium: custom validators outside the supported boundary may not be recognized.",
                "impact": "Medium",
                "owaspCategory": {
                  "id": "ASI02:2026",
                  "name": "Tool Misuse & Exploitation"
                }
              },
              "shortDescription": {
                "text": "Missing tool input validation"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Tool output or description flows into a later model prompt without a trusted sanitizer."
              },
              "help": {
                "text": "Pass tool-controlled text through a configured sanitizer before prompt construction. FP risk: Medium-High: intraprocedural prompt-flow analysis is intentionally heuristic."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-004",
              "id": "SENT-004",
              "name": "Unsanitized tool content in prompt",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium-High: intraprocedural prompt-flow analysis is intentionally heuristic.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI01:2026",
                  "name": "Agent Goal Hijack"
                }
              },
              "shortDescription": {
                "text": "Unsanitized tool content in prompt"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Source or configuration contains a credential signature or contextual high-entropy secret."
              },
              "help": {
                "text": "Load credentials from an external secret store or environment at runtime. FP risk: Low-Medium: high-entropy test values require paired path/fingerprint allowlisting."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-005",
              "id": "SENT-005",
              "name": "Hardcoded secret",
              "properties": {
                "engine": "semgrep",
                "falsePositiveRisk": "Low-Medium: high-entropy test values require paired path/fingerprint allowlisting.",
                "impact": "Critical",
                "owaspCategory": {
                  "id": "ASI03:2026",
                  "name": "Identity & Privilege Abuse"
                }
              },
              "shortDescription": {
                "text": "Hardcoded secret"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "An HTTP route lacks inherited authentication or uses a no-op verifier."
              },
              "help": {
                "text": "Require credential verification and an explicit rejection path before route execution. FP risk: Low: intentional public routes must be explicitly configured."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-006",
              "id": "SENT-006",
              "name": "Missing or ineffective route authentication",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Low: intentional public routes must be explicitly configured.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI03:2026",
                  "name": "Identity & Privilege Abuse"
                }
              },
              "shortDescription": {
                "text": "Missing or ineffective route authentication"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Manifest bytes reach registration without a trusted hash or signature verification."
              },
              "help": {
                "text": "Verify a pinned SHA-256 digest or trusted detached signature before parsing and use. FP risk: Low: custom verification beyond the supported crypto APIs may require later coverage."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-007",
              "id": "SENT-007",
              "name": "Unverified tool manifest",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Low: custom verification beyond the supported crypto APIs may require later coverage.",
                "impact": "Medium",
                "owaspCategory": {
                  "id": "ASI04:2026",
                  "name": "Agentic Supply Chain Vulnerabilities"
                }
              },
              "shortDescription": {
                "text": "Unverified tool manifest"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Caller-controlled paths reach filesystem access without enforced containment within the intended directory or repository."
              },
              "help": {
                "text": "Resolve the requested path and allowed root, reject paths outside the root using component-aware containment, and use the validated value. FP risk: Medium: intentionally unrestricted file tools and unsupported custom validators require review; string prefixes alone do not prove containment."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-012",
              "id": "SENT-012",
              "name": "Path containment failure",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium: intentionally unrestricted file tools and unsupported custom validators require review; string prefixes alone do not prove containment.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI02:2026",
                  "name": "Tool Misuse & Exploitation"
                }
              },
              "shortDescription": {
                "text": "Path containment failure"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Recoverable tool metadata instructs an agent to override instructions, disclose secrets, or redirect execution to another tool."
              },
              "help": {
                "text": "Remove instruction overrides, secret-disclosure requests and unrelated tool redirection from tool and parameter descriptions. FP risk: Medium: legitimate security tooling may quote attack instructions; explicit quoted warnings are excluded, and remaining candidates need review."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-013",
              "id": "SENT-013",
              "name": "Tool-description poisoning",
              "properties": {
                "engine": "ast",
                "falsePositiveRisk": "Medium: legitimate security tooling may quote attack instructions; explicit quoted warnings are excluded, and remaining candidates need review.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI01:2026",
                  "name": "Agent Goal Hijack"
                }
              },
              "shortDescription": {
                "text": "Tool-description poisoning"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Caller-controlled references reach command option positions without enforced rejection."
              },
              "help": {
                "text": "Reject option-like references before invocation or use command-specific option terminators and safe object APIs. FP risk: Medium: custom validation and unsupported command wrappers need review; argv lists alone do not prevent option injection."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-014",
              "id": "SENT-014",
              "name": "Command option injection",
              "properties": {
                "engine": "ast",
                "falsePositiveRisk": "Medium: custom validation and unsupported command wrappers need review; argv lists alone do not prevent option injection.",
                "impact": "Critical",
                "owaspCategory": {
                  "id": "ASI05:2026",
                  "name": "Unexpected Code Execution"
                }
              },
              "shortDescription": {
                "text": "Command option injection"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "A caller URL reaches an outbound request without enforced scheme and destination restrictions."
              },
              "help": {
                "text": "Permit only required HTTP(S) destinations, reject private and loopback addresses, and enforce checks on every requested URL and redirect. FP risk: Medium: custom clients and unsupported validators require review; DNS rebinding is outside this rule's claim."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-015",
              "id": "SENT-015",
              "name": "Server-side request forgery",
              "properties": {
                "engine": "ast",
                "falsePositiveRisk": "Medium: custom clients and unsupported validators require review; DNS rebinding is outside this rule's claim.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI02:2026",
                  "name": "Tool Misuse & Exploitation"
                }
              },
              "shortDescription": {
                "text": "Server-side request forgery"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "An HTTP caller without its own credential can select an operator credential for an authenticated request."
              },
              "help": {
                "text": "Reject missing caller credentials before forwarding the request; keep operator credentials outside caller-selectable fallback paths. FP risk: Medium: intended delegation needs an enforced authorization policy. Middleware presence or a nearby check alone does not establish one."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-016",
              "id": "SENT-016",
              "name": "Unauthorized operator credential fallback",
              "properties": {
                "engine": "ast",
                "falsePositiveRisk": "Medium: intended delegation needs an enforced authorization policy. Middleware presence or a nearby check alone does not establish one.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI03:2026",
                  "name": "Identity & Privilege Abuse"
                }
              },
              "shortDescription": {
                "text": "Unauthorized operator credential fallback"
              }
            }
