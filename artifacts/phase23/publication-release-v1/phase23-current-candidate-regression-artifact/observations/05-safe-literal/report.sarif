              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-013",
              "id": "SENT-013",
              "name": "Tool-description poisoning",
              "properties": {
                "engine": "ast",
                "falsePositiveRisk": "Medium: legitimate security tooling may quote attack instructions; explicit quoted warnings are excluded, and remaining candidates need review.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI01:2026",
                  "name": "Agent Goal Hijack"
                }
              },
              "shortDescription": {
                "text": "Tool-description poisoning"
              }
            },
            {
