                "falsePositiveRisk": "Low-Medium: high-entropy test values require paired path/fingerprint allowlisting.",
                "impact": "Critical",
                "owaspCategory": {
                  "id": "ASI03:2026",
                  "name": "Identity & Privilege Abuse"
                }
              },
              "shortDescription": {
                "text": "Hardcoded secret"
