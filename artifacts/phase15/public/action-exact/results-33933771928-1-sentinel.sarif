            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "The tool declares filesystem or network access broader than its handler uses."
              },
              "help": {
                "text": "Narrow each declared scope to the resources the handler actually requires. FP risk: Medium: legitimately broad tools require an explicit capability justification."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-001",
              "id": "SENT-001",
              "name": "Overly broad tool permission scope",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium: legitimately broad tools require an explicit capability justification.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI03:2026",
                  "name": "Identity & Privilege Abuse"
                }
              },
              "shortDescription": {
                "text": "Overly broad tool permission scope"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Tool-controlled input reaches an unsafe execution or deserialization sink."
              },
              "help": {
                "text": "Replace dynamic execution with explicit parsers and fixed command allowlists. FP risk: Low: fixed literal subprocess argument vectors are excluded."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-002",
              "id": "SENT-002",
              "name": "Unsafe execution from tool input",
              "properties": {
                "engine": "semgrep",
                "falsePositiveRisk": "Low: fixed literal subprocess argument vectors are excluded.",
                "impact": "Critical",
                "owaspCategory": {
                  "id": "ASI05:2026",
                  "name": "Unexpected Code Execution"
                }
              },
              "shortDescription": {
                "text": "Unsafe execution from tool input"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "A tool handler consumes parameters before framework or explicit validation."
              },
              "help": {
                "text": "Use an official input schema or explicit validation before first use. FP risk: Medium: custom validators outside the supported boundary may not be recognized."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-003",
              "id": "SENT-003",
              "name": "Missing tool input validation",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium: custom validators outside the supported boundary may not be recognized.",
                "impact": "Medium",
                "owaspCategory": {
                  "id": "ASI02:2026",
                  "name": "Tool Misuse & Exploitation"
                }
              },
              "shortDescription": {
                "text": "Missing tool input validation"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Tool output or description flows into a later model prompt without a trusted sanitizer."
              },
              "help": {
                "text": "Pass tool-controlled text through a configured sanitizer before prompt construction. FP risk: Medium-High: intraprocedural prompt-flow analysis is intentionally heuristic."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-004",
              "id": "SENT-004",
              "name": "Unsanitized tool content in prompt",
              "properties": {
                "engine": "hybrid",
                "falsePositiveRisk": "Medium-High: intraprocedural prompt-flow analysis is intentionally heuristic.",
                "impact": "High",
                "owaspCategory": {
                  "id": "ASI01:2026",
                  "name": "Agent Goal Hijack"
                }
              },
              "shortDescription": {
                "text": "Unsanitized tool content in prompt"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": -1.0
              },
              "fullDescription": {
                "text": "Source or configuration contains a credential signature or contextual high-entropy secret."
              },
              "help": {
                "text": "Load credentials from an external secret store or environment at runtime. FP risk: Low-Medium: high-entropy test values require paired path/fingerprint allowlisting."
              },
              "helpUri": "https://github.com/BashaarJavaid/MCP-Sentinel/blob/main/docs/rules.md#sent-005",
              "id": "SENT-005",
              "name": "Hardcoded secret",
              "properties": {
